{
  "rules": {
    ".read": false,
    ".write": false,
    "slideshow": {
      ".read": true,
      "control": {
        ".write": "auth != null && auth.token.type === 'admin'"
      },
      "commands": {
        ".write": "auth != null && auth.token.type === 'admin'"
      },
      "presence": {
        "$session": {
          ".write": "$session.matches(/^[A-Za-z0-9_-]{8,40}$/)",
          ".validate": "newData.hasChildren(['at']) && newData.child('at').isNumber()",
          "at": { ".validate": true },
          "slide": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "showing": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "held": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        }
      }
    },
    "live": {
      ".read": true,
      "control": {
        ".write": "auth != null && auth.token.liveControl === true"
      },
      "commands": {
        ".write": "auth != null && auth.token.liveControl === true"
      },
      "presence": {
        "$session": {
          ".write": "$session.matches(/^[A-Za-z0-9_-]{8,40}$/)",
          ".validate": "newData.hasChildren(['at']) && newData.child('at').isNumber()",
          "at": { ".validate": true },
          "competition": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,9}$/)" },
          "showing": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "feed": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
